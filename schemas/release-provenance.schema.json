{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingsoftcloud.github.io/ksadk-web/schemas/release-provenance.schema.json",
  "title": "KsADK Web release provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "version",
    "source_commit",
    "interaction_contract_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package": {
      "const": "@kingsoftcloud/ksadk-web"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "interaction_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
