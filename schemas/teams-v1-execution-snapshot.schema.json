{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "groupId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "teamRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "watermark": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "run",
              "child_invocation"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "memberId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "authorityRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "groupId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "memberId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "bindingRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "providerRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "sessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "runId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "itemId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "authorityRef",
                  "groupId",
                  "memberId",
                  "bindingRef",
                  "providerRef",
                  "sessionId",
                  "runId"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "parentNodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "nodeId",
          "kind",
          "title",
          "status"
        ],
        "additionalProperties": {}
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "kind": {
            "type": "string",
            "enum": [
              "dependency",
              "invocation"
            ]
          }
        },
        "required": [
          "source",
          "target",
          "kind"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "groupId",
    "teamRunId",
    "watermark",
    "nodes",
    "edges"
  ],
  "additionalProperties": {},
  "$id": "https://ksadk.io/schemas/teams/v1/execution-snapshot.json",
  "title": "teams.ksadk.io/v1 execution-snapshot"
}
